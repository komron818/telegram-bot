from aiogram import Bot, Dispatcher, types
from aiogram.types import Message, ReplyKeyboardMarkup, KeyboardButton, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.fsm.state import StatesGroup, State
from aiogram.fsm.context import FSMContext
from aiogram.fsm.storage.memory import MemoryStorage
import asyncio

TOKEN = "YOUR_API_TOKEN"
ADMIN_ID = 6497374401

bot = Bot(token=TOKEN)
dp = Dispatcher(storage=MemoryStorage())

class OrderState(StatesGroup):
    waiting_contact = State()
    waiting_location = State()
    choosing_product = State()
    choosing_quantity = State()
    viewing_cart = State()

products = {
    "Яйца": 40000,
    "Вода 5 л": 6000,
    "Вода 10 л": 11000,
    "Картошка": 15000,
    "Сахар": 20000,
    "Масло": 25000,
}

user_orders = {}

@dp.message(lambda message: message.text == "/start")
async def start(message: Message, state: FSMContext):
    user_orders[message.from_user.id] = {}
    contact_btn = KeyboardButton(text="Отправить номер", request_contact=True)
    kb = ReplyKeyboardMarkup(keyboard=[[contact_btn]], resize_keyboard=True, one_time_keyboard=True)
    await message.answer("Отправьте ваш номер телефона:", reply_markup=kb)
    await state.set_state(OrderState.waiting_contact)

@dp.message(lambda message: message.contact, OrderState.waiting_contact)
async def contact_received(message: Message, state: FSMContext):
    location_btn = KeyboardButton(text="Отправить локацию", request_location=True)
    kb = ReplyKeyboardMarkup(keyboard=[[location_btn]], resize_keyboard=True, one_time_keyboard=True)
    await message.answer("Теперь отправьте вашу локацию:", reply_markup=kb)
    await state.set_state(OrderState.waiting_location)

@dp.message(lambda message: message.location, OrderState.waiting_location)
async def location_received(message: Message, state: FSMContext):
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=key, callback_data=f"product:{key}")] for key in products.keys()
    ] + [[InlineKeyboardButton(text="🛒 Корзина", callback_data="cart")]])
    await message.answer("Выберите товар:", reply_markup=kb)
    await state.set_state(OrderState.choosing_product)

@dp.callback_query(lambda c: c.data.startswith("product:"), OrderState.choosing_product)
async def choose_quantity(callback: types.CallbackQuery, state: FSMContext):
    product = callback.data.split(":")[1]
    await state.update_data(selected_product=product)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=str(i), callback_data=f"qty:{i}")] for i in range(1, 11)
    ] + [[
        InlineKeyboardButton(text="Назад", callback_data="back"),
        InlineKeyboardButton(text="🛒 Корзина", callback_data="cart")
    ]])
    await callback.message.answer(f"Сколько штук '{product}' вы хотите?", reply_markup=kb)
    await state.set_state(OrderState.choosing_quantity)

@dp.callback_query(lambda c: c.data.startswith("qty:"), OrderState.choosing_quantity)
async def add_to_cart(callback: types.CallbackQuery, state: FSMContext):
    qty = int(callback.data.split(":")[1])
    data = await state.get_data()
    product = data["selected_product"]
    user_id = callback.from_user.id
    cart = user_orders[user_id]
    cart[product] = cart.get(product, 0) + qty

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=key, callback_data=f"product:{key}")] for key in products.keys()
    ] + [[InlineKeyboardButton(text="🛒 Корзина", callback_data="cart")]])
    await callback.message.answer(f"Добавлено: {product} — {qty} шт.", reply_markup=kb)
    await state.set_state(OrderState.choosing_product)

@dp.callback_query(lambda c: c.data == "cart")
async def show_cart(callback: types.CallbackQuery, state: FSMContext):
    user_id = callback.from_user.id
    cart = user_orders.get(user_id, {})
    if not cart:
        await callback.message.answer("Корзина пуста.")
        return

    text = "Ваш чек:

"
    total = 0
    for name, qty in cart.items():
        price = products[name] * qty
        total += price
        text += f"{name} — {qty} шт. = {price:,} сум\n"
    text += f"
Общая сумма: {total:,} сум"

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Подтвердить", callback_data="confirm")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back")]
    ])
    await callback.message.answer(text, reply_markup=kb)
    await state.set_state(OrderState.viewing_cart)

@dp.callback_query(lambda c: c.data == "back")
async def go_back(callback: types.CallbackQuery, state: FSMContext):
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=key, callback_data=f"product:{key}")] for key in products.keys()
    ] + [[InlineKeyboardButton(text="🛒 Корзина", callback_data="cart")]])
    await callback.message.answer("Выберите товар:", reply_markup=kb)
    await state.set_state(OrderState.choosing_product)

@dp.callback_query(lambda c: c.data == "confirm")
async def confirm_order(callback: types.CallbackQuery, state: FSMContext):
    user_id = callback.from_user.id
    cart = user_orders.get(user_id, {})
    text = "✅ Новый заказ:

"
    total = 0
    for name, qty in cart.items():
        price = products[name] * qty
        total += price
        text += f"{name} — {qty} шт. = {price:,} сум\n"
    text += f"
Общая сумма: {total:,} сум"

    await bot.send_message(ADMIN_ID, f"Заказ от {user_id}:

" + text)
    await callback.message.answer("Спасибо за заказ! Мы скоро свяжемся с вами.")
    await state.clear()

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())